<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="10dp">

    <!-- Display Screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.2"
        android:orientation="vertical"
        android:gravity="bottom"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text=""
            android:textColor="#999999"
            android:textSize="24sp"
            android:paddingBottom="12dp"/>

        <TextView
            android:id="@+id/tvDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0"
            android:textColor="#171717"
            android:textSize="56sp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="28sp"
            android:autoSizeMaxTextSize="56sp"
            android:autoSizeStepGranularity="2sp"/>

    </LinearLayout>

    <!-- Row 1 : Clear, Backspace, Divide, Multiply -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnClear"
            android:text="C"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/orange_button"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"/>

        <Button
            android:id="@+id/btnBack"
            android:text="⌫"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/orange_button"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"/>

        <Button
            android:id="@+id/btnDivide"
            android:text="÷"
            android:textSize="26sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/orange_button"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"/>

        <Button
            android:id="@+id/btnMultiply"
            android:text="×"
            android:textSize="26sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/orange_button"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"/>

    </LinearLayout>

    <!-- Row 2 : 7, 8, 9, Minus -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn7"
            android:text="7"
            android:textSize="26sp"
            android:textColor="#222222"
            android:background="@drawable/number_button"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"/>

        <Button
            android:id="@+id/btn8"
            android:text="8"
            android:textSize="26sp"
            android:textColor="#222222"
            android:background="@drawable/number_button"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"/>

        <Button
            android:id="@+id/btn9"
            android:text="9"
            android:textSize="26sp"
            android:textColor="#222222"
            android:background="@drawable/number_button"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"/>

        <Button
            android:id="@+id/btnSubtract"
            android:text="−"
            android:textSize="26sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/orange_button"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"/>

    </LinearLayout>

    <!-- Row 3 : 4, 5, 6, Plus -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn4"
            android:text="4"
            android:textSize="26sp"
            android:textColor="#222222"
            android:background="@drawable/number_button"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"/>

        <Button
            android:id="@+id/btn5"
            android:text="5"
            android:textSize="26sp"
            android:textColor="#222222"
            android:background="@drawable/number_button"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"/>

        <Button
            android:id="@+id/btn6"
            android:text="6"
            android:textSize="26sp"
            android:textColor="#222222"
            android:background="@drawable/number_button"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"/>

        <Button
            android:id="@+id/btnAdd"
            android:text="+"
            android:textSize="26sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/orange_button"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"/>

    </LinearLayout>

    <!-- Row 4 : 1, 2, 3, Equals -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn1"
            android:text="1"
            android:textSize="26sp"
            android:textColor="#222222"
            android:background="@drawable/number_button"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"/>

        <Button
            android:id="@+id/btn2"
            android:text="2"
            android:textSize="26sp"
            android:textColor="#222222"
            android:background="@drawable/number_button"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"/>

        <Button
            android:id="@+id/btn3"
            android:text="3"
            android:textSize="26sp"
            android:textColor="#222222"
            android:background="@drawable/number_button"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"/>

        <Button
            android:id="@+id/btnEquals"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:background="@drawable/orange_button"
            android:backgroundTint="@null"
            android:text="="
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

    </LinearLayout>

    <!-- Row 5 : Sign, Zero, Decimal, Double Zero -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSign"
            android:text="+/−"
            android:textSize="22sp"
            android:textColor="#222222"
            android:background="@drawable/special_button"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"/>

        <Button
            android:id="@+id/btn0"
            android:text="0"
            android:textSize="26sp"
            android:textColor="#222222"
            android:background="@drawable/number_button"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"/>

        <Button
            android:id="@+id/btnDot"
            android:text="."
            android:textSize="26sp"
            android:textColor="#222222"
            android:background="@drawable/special_button"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"/>

        <Button
            android:id="@+id/btn00"
            android:text="00"
            android:textSize="26sp"
            android:textColor="#222222"
            android:background="@drawable/number_button"
            android:backgroundTint="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"/>

    </LinearLayout>

</LinearLayout>
